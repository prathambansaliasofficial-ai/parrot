# FreeResources — acquisition system configuration
# Copy the values you need into .env (never commit real keys).

# ---------------------------------------------------------------- AI provider
# Any OpenAI-compatible chat-completions endpoint. Leave AI_API_KEY empty to keep
# AI classification and the admin copilot disabled (both report that honestly).
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ------------------------------------------------------------ search provider
# Optional. Without it, discovery uses official-domain sitemap crawling only.
BRAVE_SEARCH_API_KEY=

# ------------------------------------------------------------------ storage
# "local" (default) writes to storage/acquisition. Set to "r2" with the R2_*
# values below to store acquired documents in a dedicated Cloudflare R2 bucket.
# Verify the live bucket with: npm run storage:check
ACQUISITION_STORAGE_DRIVER=local
ACQUISITION_STORAGE_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freeresources-academic
# Optional: full endpoint, e.g. https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional: public delivery domain for published documents
R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------ pdf compression
# Ghostscript binary. Left empty, the worker probes PATH, then
# .tools/gs/bin/gswin64c.exe, then the standard Windows install location.
# Docker images install it at /usr/bin/gs.
GHOSTSCRIPT_BIN=

# ------------------------------------------------------------------- worker
WORKER_POLL_MS=2000

# Test-only: allow fetching from localhost/private addresses. Never enable in production.
ACQUISITION_ALLOW_LOCAL_FETCH=0

# --------------------------------------------------------------------- site
# Administrator account. Created automatically the first time the database is
# initialised (so /admin is reachable on a fresh deployment). Change the
# password before making the site public.
ADMIN_EMAIL=admin@freeresources.in
ADMIN_PASSWORD=FreeResources@2026

# ------------------------------------------------------- cloudflare d1 (read)
# The Next.js app runs on Vercel, which has no D1 binding, so it reads the
# Cloudflare database over the REST API and copies the rows into its local
# SQLite database at startup (lib/d1-hydrate.ts). Use a token with D1 read
# permission only. Leave these empty to run purely on local SQLite.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# ------------------------------------------------------------- parrot tutor
# FastAPI tutor endpoints used by the Parrot AI widget. On Vercel the backend
# service binding injects BACKEND_URL, so this stays empty there.
PARROT_API_BASE_URL=http://localhost:8000
# Optional canonical URL used by metadata and origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------ cloudflare
# The acquisition Worker uses native Cloudflare bindings (D1, R2, Queues,
# Workflows) and needs no R2 access keys. Bindings are declared in
# wrangler.jsonc; see docs/CLOUDFLARE.md.
#
# ADMIN_API_TOKEN is a Worker *secret*, never a file value:
#   npx wrangler secret put ADMIN_API_TOKEN --config wrangler.jsonc
#
# The R2_* variables above remain for the local Node worker only. Do not copy
# them into a deployed Worker.
