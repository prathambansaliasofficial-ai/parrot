# Public browser values only. Supabase publishable/anon keys are designed for the client
# when Row Level Security is correctly enabled. Never put service-role/secret keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
