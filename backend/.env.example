# Copy to backend/.env locally. Never commit backend/.env or paste server secrets in chat.
#
# The API runs without any of these values: in that case it returns an empty
# resource catalog and labels tutor replies as demo mode. It never invents
# academic records to fill the catalog.

# ------------------------------------------------------------------ Supabase
# Optional. Server-side only; never expose a secret/service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
# Use the Supabase secret key (sb_secret_...) here; the legacy service_role key also works temporarily.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-resources
# Set a long random value. Required to use the admin upload/link endpoints.
INGESTION_API_KEY=
MAX_UPLOAD_SIZE_MB=50

# ---------------------------------------------------------------------- HTTP
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------- ASI:One / ASI:1
# OpenAI-compatible endpoint, server-side only.
# Optional: without ASI_ONE_API_KEY tutor responses run in labelled demo mode.
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1
