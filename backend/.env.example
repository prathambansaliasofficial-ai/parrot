# Copy to backend/.env locally. Never commit backend/.env or paste server secrets in chat.
SUPABASE_URL=https://yqzlfblnzyznedvcoyuz.supabase.co
# Use the Supabase secret key (sb_secret_...) here; legacy service_role key also works temporarily.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-resources
# Set a long random value. Required to use the admin upload/link endpoints.
INGESTION_API_KEY=
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000
MAX_DOCUMENT_PAGES=500
MAX_EXTRACTED_CHARACTERS=2000000
MAX_RETRIEVAL_RESULTS=8
# Optional; when unset, passage search works but generated answers are disabled.
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1
INGESTION_PIPELINE_VERSION=1
