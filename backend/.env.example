# Supabase server credentials; never expose the service-role/secret key to the browser.
# Optional: without these the API serves the clearly labelled demo resource catalog
# and stores learning progress in an in-process demo store.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-secret
CORS_ORIGINS=http://localhost:3000

# ASI:One / ASI:1 — OpenAI-compatible endpoint, server-side only.
# Optional: without ASI_ONE_API_KEY tutor responses run in labelled demo mode.
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1
